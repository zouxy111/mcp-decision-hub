# 复制为 .env 后按需填写。带默认值的项可省略。
# 完整变量表见 docs/ops/deployment.md 第 3 节。

# --- 数据库 ---
DATABASE_URL=sqlite:///./hub.db

# --- Web 会话（生产环境必须改成随机值）---
SESSION_SECRET=dev-secret-change-me

# --- 管理员（首次启动时创建，首登强制改密）---
ADMIN_USERNAME=
ADMIN_INITIAL_PASSWORD=

# --- LLM ---
DEEPSEEK_API_KEY=
LLM_PROVIDER_NAME=DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- 轮次与超时 ---
TASK_TIMEOUT_SECONDS=259200
MAX_ROUNDS=10
INVITE_TTL_SECONDS=604800
TIMEOUT_SCAN_INTERVAL_SECONDS=60
